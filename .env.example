# LLM Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct

# GitHub Configuration
GITHUB_TOKEN=ghp-your-github-token-here
API_TIMEOUT=30
REVIEW_OUTPUT_PATH=

# Review Configuration
REVIEW_LANGUAGE=en

# Dynamic Context Sizing
MAX_TOTAL_CHARS=20000
MAX_PATCH_CHARS=10000
SMALL_PR_THRESHOLD=5
MEDIUM_PR_THRESHOLD=15

# Performance Throttling
MAX_CONCURRENT_AGENTS=4
AGENT_TIMEOUT_SECONDS=45

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=2

# Knowledge Base Configuration
KB_PATH=knowledge_base/CrewAI_Review_Bot
KB_MAX_CHARS=8000

# Webhook Configuration
# WEBHOOK_SECRET is required in production. Use: python -c "import secrets; print(secrets.token_hex(32))"
# For local development only, set WEBHOOK_DEV_MODE=true to skip signature verification.
WEBHOOK_SECRET=
WEBHOOK_DEV_MODE=false
WEBHOOK_PORT=8000
WEBHOOK_HOST=0.0.0.0
RESPONSE_LOOP_ENABLED=true
AUTO_REVIEW_ON_PUSH=true

# Conversation Digest Configuration
CONVERSATIONS_DIR=
MAX_DIGEST_CHARS=2000
MAX_THREAD_ENTRIES=5
CONVERSATION_MAX_AGE_DAYS=14
